# ---- Application ----
APP_NAME=AI Dev Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=false

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ---- Database ----
# Change this value before deploying anywhere. Never commit a real password.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_DB=ai_dev_platform

# Full DSN override (takes precedence over the POSTGRES_* variables above).
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_dev_platform

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# ---- File storage ----
# Root directory that holds the uploaded files. Relative paths are resolved
# against the backend directory; absolute paths are used as they are.
# STORAGE_ROOT=./storage
STORAGE_MAX_UPLOAD_SIZE=52428800
STORAGE_ALLOWED_EXTENSIONS=pdf,docx,md,markdown,txt,json,yaml,yml

# ---- Workflow checkpointer ----
# Backend that persists the LangGraph checkpoints:
#   postgres - production, checkpoints live in their own PostgreSQL database
#   sqlite   - local development and the test suite
#   memory   - unit tests, nothing is written to disk
WORKFLOW_CHECKPOINT_BACKEND=sqlite

# DSN of the PostgreSQL database that holds the checkpoints. When it is empty
# the DSN is derived from the POSTGRES_* variables above and the database name
# gets the suffix "_checkpoints".
# CHECKPOINT_DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_dev_platform_checkpoints

# File that holds the SQLite checkpoints (only used by the sqlite backend).
# WORKFLOW_SQLITE_CHECKPOINT_PATH=./.checkpoint/checkpoints.sqlite

# Registry key of the workflow that is started when the caller does not name one.
WORKFLOW_DEFAULT_KEY=dev_workflow
# Upper bound of the rework rounds of a single workflow instance.
WORKFLOW_MAX_ITERATIONS=3

# ---- Ports published by docker compose ----
BACKEND_PORT=8000
FRONTEND_PORT=80

# ---- Frontend build time variable (baked into the bundle by Vite) ----
VITE_API_BASE_URL=/api/v1
