# Copy to `.env.local` and adjust as needed. Only variables prefixed with
# `VITE_` are exposed to the browser bundle.

VITE_APP_TITLE=AI Dev Platform

# Base URL of the backend API. The default "/api/v1" works with the Vite dev
# proxy (development) and with the nginx reverse proxy (Docker).
VITE_API_BASE_URL=/api/v1

# Target address the Vite dev server proxies "/api" to.
VITE_DEV_API_PROXY_TARGET=http://localhost:8000

# Dev server ports
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
